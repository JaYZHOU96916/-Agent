REDIS_URL=redis://redis:6379/0
SANDBOX_IMAGE=data-analysis-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_CPU_NANO_CPUS=1000000000
# start.sh detects the socket group on Linux; Docker Desktop's VM proxy uses group 0 inside containers.
# DOCKER_GID=0
# macOS Docker Desktop may use ~/.docker/run/docker.sock instead of /var/run/docker.sock.
# start.sh detects it automatically; set an absolute path here to override.
# DOCKER_SOCKET_PATH=/absolute/path/to/docker.sock
DATASET_DIR=uploads
UPLOAD_MAX_BYTES=20971520
DATASET_MAX_ROWS=100000
DATASET_MAX_COLUMNS=200
PROFILING_TIMEOUT_SECONDS=30
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
API_TOKEN=
SEMANTIC_CACHE_ENABLED=false
EMBEDDING_MODEL=
SEMANTIC_CACHE_THRESHOLD=0.98
CACHE_TTL_SECONDS=3600
